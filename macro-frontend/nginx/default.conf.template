# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only defined environment variables are substituted, so nginx's own $variables stay as they are.
map $status $log_level {
    ~^5     error;
    ~^4     warn;
    default info;
}

# A closed set of values, one per routed prefix: the route is a Loki label, unlike the URI
map $uri $gateway_route {
    ~^/macro-analyzer/(series-config|chart-data|regional-statistics|parliament|municipalities|regions|constituencies)(/|$) $1;
    ~^/macro-analyzer/scrape/(regional-statistics|macro-series|parliament|election)(/|$) scrape-$1;
    ~^/macro-analyzer(/|$) unknown-api;
    /telemetry/collect telemetry;
    default frontend;
}

# nginx has no OpenTelemetry module, so it makes no span. $request_id, 32 hex characters, is the trace id of everything the
# backend does for this request, which is what ties this access line to that trace. Tempo sees the service's span as the
# trace's first span, with a parent that was never exported
map $request_id $gateway_span_id {
    "~^(.{16})" $1;
}

# Empty on routes no service answers, so a line only offers a trace link where a trace exists
map $gateway_route $trace_id {
    frontend    "";
    telemetry   "";
    unknown-api "";
    default     $request_id;
}

log_format json_access escape=json
    '{"time":"$time_iso8601","level":"$log_level","method":"$request_method","uri":"$request_uri",'
    '"route":"$gateway_route","status":$status,"bytes":$body_bytes_sent,"request_time":$request_time,'
    '"upstream_response_time":"$upstream_response_time","upstream_status":"$upstream_status",'
    '"trace_id":"$trace_id"}';

server {
    listen 80;
    access_log /dev/stdout json_access;
    root /usr/share/nginx/html;
    # The container listens on 80 whatever port it is published on, so an absolute redirect would name the wrong port
    absolute_redirect off;

    # Each upstream is a variable so it is resolved per request: nginx starts even when a backend
    # is not up yet, and picks up a new address when its container is recreated.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # A location inherits these as long as it sets none of the same directive itself.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Always replaced, also when a client sent one: port 8081 is published, and a caller must not choose trace ids or sampling
    proxy_set_header traceparent "00-$request_id-$gateway_span_id-01";
    proxy_set_header tracestate "";
    proxy_set_header baggage "";
    # A full SCB or election scrape triggered through the proxy can run for minutes
    proxy_read_timeout 30m;

    location = /macro-analyzer/series-config {
        set $backend ${MACRO_SERIES_URL};
        proxy_pass $backend;
    }
    location = /macro-analyzer/chart-data {
        set $backend ${MACRO_SERIES_URL};
        proxy_pass $backend;
    }
    location /macro-analyzer/scrape/macro-series/ {
        set $backend ${MACRO_SERIES_URL};
        proxy_pass $backend;
    }

    location /macro-analyzer/regional-statistics/ {
        set $backend ${REGIONAL_STATISTICS_URL};
        proxy_pass $backend;
    }
    location /macro-analyzer/scrape/regional-statistics/ {
        set $backend ${REGIONAL_STATISTICS_URL};
        proxy_pass $backend;
    }

    location /macro-analyzer/parliament/ {
        set $backend ${PARLIAMENT_URL};
        proxy_pass $backend;
    }
    location /macro-analyzer/scrape/parliament/ {
        set $backend ${PARLIAMENT_URL};
        proxy_pass $backend;
    }

    location /macro-analyzer/municipalities/ {
        set $backend ${ELECTION_URL};
        proxy_pass $backend;
    }
    location /macro-analyzer/regions/ {
        set $backend ${ELECTION_URL};
        proxy_pass $backend;
    }
    location /macro-analyzer/constituencies/ {
        set $backend ${ELECTION_URL};
        proxy_pass $backend;
    }

    location /macro-analyzer/scrape/election/ {
        set $backend ${ELECTION_URL};
        proxy_pass $backend;
    }

    # Any other API path, for every method. Without these it would fall through to location / and get index.html with a 200
    location /macro-analyzer/ {
        return 404;
    }
    location = /macro-analyzer {
        return 404;
    }

    location = /telemetry/collect {
        if ($request_method != POST) {
            add_header Allow POST always;
            return 405;
        }

        client_max_body_size 256k;
        # The observability stack is optional: a browser's POST must fail fast while it is down. Docker's DNS takes
        # seconds to give up on the name of a stopped container, hence the short resolver_timeout
        resolver_timeout 1s;
        # Without this, every POST while the optional stack is down is an [error] line in the gateway's log
        error_log stderr crit;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;

        set $backend ${FARO_URL}/collect;
        proxy_pass $backend;
    }

    # Hashed build assets never change, so they can be cached indefinitely
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";

        # nginx has no MIME type for .mjs; module workers (MapLibre) require a JavaScript type
        location ~ \.mjs$ {
            default_type text/javascript;
        }
    }

    # BrowserRouter routes (e.g. /parliament) must fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
