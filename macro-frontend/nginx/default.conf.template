# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only defined environment variables are substituted, so nginx's own $variables stay as they are.
server {
    listen 80;
    root /usr/share/nginx/html;

    # The bundle is built with VITE_API_URL empty, so the browser calls the backend on this origin.
    # The upstream is a variable so it is resolved per request: nginx starts even when the backend
    # is not up yet, and picks up a new address when the backend container is recreated.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    location /macro-analyzer/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A full SCB or election scrape triggered through the proxy can run for minutes
        proxy_read_timeout 30m;
    }

    # Hashed build assets never change, so they can be cached indefinitely
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";

        # nginx has no MIME type for .mjs; module workers (MapLibre) require a JavaScript type
        location ~ \.mjs$ {
            default_type text/javascript;
        }
    }

    # BrowserRouter routes (e.g. /parliament) must fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
