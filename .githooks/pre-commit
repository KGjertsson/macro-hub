#!/bin/sh
# Blocks commits that stage .env files (secrets; .env.example is allowed) or Java that fails Checkstyle.
# Enable with: git config core.hooksPath .githooks

blocked=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '(^|/)\.env(\..+)?$' \
  | grep -vE '(^|/)\.env\.example$')

if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit .env files (they contain secrets):" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  echo "Unstage with: git restore --staged <file>" >&2
  exit 1
fi

java=$(git diff --cached --name-only --diff-filter=ACMR -- 'macro-backend/*.java')
if [ -n "$java" ]; then
  # Checkstyle reads the files on disk, so unstaged changes to a staged file are checked too.
  # shellcheck disable=SC2086
  macro-infra/scripts/checkstyle.sh $java
  case $? in
    0) ;;
    1) echo "pre-commit: Checkstyle violations above (macro-backend/checkstyle.xml)" >&2; exit 1 ;;
    *) echo "pre-commit: Checkstyle could not run, see Maven's output above" >&2; exit 1 ;;
  esac
fi
