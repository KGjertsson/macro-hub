# Copy to .env (same directory) and fill in. .env is gitignored.
# Spring loads it via spring.config.import when this service runs with mvnw. Compose reads it with
# --env-file macro-backend/macro-series-service/.env
RIKSBANKEN_PROD_SUBSCRIPTION_KEY=
FED_PROD_SUBSCRIPTION_KEY=
# Optional: the database roles' passwords, read by Compose and, for its own, by this service. See postgres-init/ in macro-infra/docker
# REGIONAL_STATISTICS_DB_PASSWORD=
# MACRO_SERIES_DB_PASSWORD=
# PARLIAMENT_DB_PASSWORD=
# ELECTION_DB_PASSWORD=
# AUTH_DB_PASSWORD=
# MONITORING_DB_PASSWORD=
# Optional: auth-service, read by Compose. See auth-service/README.md
# AUTH_PUBLIC_URL=https://example.se
# AUTH_ADMIN_EMAIL=
# AUTH_COOKIE_SECURE=true
# AUTH_MAIL_MODE=smtp
# AUTH_MAIL_FROM=
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
