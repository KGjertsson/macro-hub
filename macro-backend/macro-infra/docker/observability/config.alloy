discovery.docker "app" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=docker"]
  }
}

discovery.relabel "app" {
  targets = discovery.docker.app.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "app" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.app.output
  forward_to = [loki.process.app.receiver]
}

// A line that isn't JSON, such as Postgres's or nginx's error log, only passes through without these labels
loki.process "app" {
  forward_to = [loki.write.local.receiver]

  stage.match {
    selector = "{service=~\"regional-statistics|macro-series|parliament|election|auth\"}"

    // A logged exception is one JSON line. This is for what doesn't go through the logger, an uncaught exception or an
    // OutOfMemoryError on the JVM's stderr: a line starting with whitespace or "Cau" (Caused by) belongs to the one before.
    // RE2 has no negative lookahead, hence the spelled-out alternatives
    stage.multiline {
      firstline     = "^([^\\sC]|C[^a]|Ca[^u])"
      max_wait_time = "3s"
    }

    stage.json {
      expressions = { level = "log.level" }
    }

    stage.template {
      source   = "level"
      template = "{{ ToLower .Value }}"
    }

    stage.labels {
      values = { level = "" }
    }
  }

  stage.match {
    selector = "{service=\"macro-frontend\"}"

    stage.json {
      expressions = { level = "", route = "" }
    }

    stage.labels {
      values = { level = "", route = "" }
    }
  }
}

// The gateway's port 8081 is published on all interfaces, so anyone who can reach it can post here through /telemetry/collect
faro.receiver "browser" {
  extra_log_labels = { service = "browser" }
  log_format       = "json"

  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    max_allowed_payload_size = "256KiB"

    rate_limiting {
      enabled    = true
      rate       = 10
      burst_size = 30
    }
  }

  // A stack frame's URL comes from the client, and by default Alloy fetches every one from inside docker_default
  sourcemaps {
    download = false
  }

  output {
    logs = [loki.process.browser.receiver]
  }
}

loki.process "browser" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = { kind = "" }
  }

  stage.labels {
    values = { kind = "" }
  }

  stage.match {
    selector = "{kind=\"exception\"}"

    stage.static_labels {
      values = { level = "error" }
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
