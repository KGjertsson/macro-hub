        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (datname) (increase(pg_stat_database_deadlocks{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "{{datname}}",
          "datasource": {
            "type": "prometheus",
