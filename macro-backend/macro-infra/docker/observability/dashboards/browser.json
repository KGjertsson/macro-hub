          "expr": "topk(20, quantile_over_time(0.75, {service=\"browser\", kind=\"measurement\"} | json v=\"value_fcp\", page=\"page_url\" | v != \"\" | unwrap v [$__range]) by (page))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "E",
          "instant": true,
          "queryType": "instant"
        },
        {
          "expr": "topk(20, quantile_over_time(0.75, {service=\"browser\", kind=\"measurement\"} | json v=\"value_ttfb\", page=\"page_url\" | v != \"\" | unwrap v [$__range]) by (page))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "F",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "page",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "page": 0
            },
            "renameByName": {
              "page": "Page",
              "Value #A": "Errors",
              "Value #B": "LCP p75",
              "Value #C": "INP p75",
              "Value #D": "CLS p75",
              "Value #E": "FCP p75",
              "Value #F": "TTFB p75"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(LCP|INP|FCP|TTFB) p75"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CLS p75"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Errors|(LCP|INP|CLS|FCP|TTFB) p75"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"browser\", kind=\"exception\"} | json | line_format \"{{ .page_url }}  {{ .stacktrace }}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
