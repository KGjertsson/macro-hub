    {
      "id": 9,
      "type": "table",
      "title": "Top error messages",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "topk(10, sum by (message) (count_over_time({service=\"browser\", kind=\"exception\"} | json message=\"value\" [$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "labels": true,
              "id": true,
              "tsNs": true,
              "Line": true,
              "labelTypes": true
            },
            "indexByName": {
              "message": 0,
              "Value #A": 1
            },
            "renameByName": {
              "message": "Message",
              "Value #A": "Count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
