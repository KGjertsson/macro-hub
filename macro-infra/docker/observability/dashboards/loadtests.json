    {
      "id": 6,
      "type": "timeseries",
      "title": "Page views per second and dropped page views",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(k6_iterations_total[$__rate_interval]))",
          "legendFormat": "page views/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(k6_dropped_iterations_total[$__rate_interval])) or vector(0)",
          "legendFormat": "dropped/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
