      "targets": [
        {
          "expr": "sum(k6_vus)",
          "legendFormat": "active",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum(k6_vus_max)",
          "legendFormat": "allocated",
          "datasource": {
            "type": "prometheus",
